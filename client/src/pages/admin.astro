---
import Layout from '../layouts/Layout.astro';
import AdminDashboard from '../components/AdminDashboard.svelte';
---

<Layout title="Admin - Tailspin Toys">
  <section class="py-8" data-testid="admin-section">
    <div class="max-w-3xl mb-10">
      <h1 class="text-4xl font-bold mb-4 text-slate-100" data-testid="admin-heading">
        Catalog administration
      </h1>
      <p class="text-xl text-slate-300">
        Add, update, and archive the games shown on the crowdfunding site.
      </p>
    </div>

    <AdminDashboard client:load />
  </section>
</Layout>
