---
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import { formatCurrency, getPreviewGames } from '../../lib/preview';

export const prerender = false;
const games = await getPreviewGames();
const [featured, ...rankedGames] = [...games].sort((a, b) => b.previewRating - a.previewRating);
---

<PreviewLayout
  title="The Arcade"
  description="A neon arcade leaderboard direction for the Tailspin Toys catalog."
  theme="arcade"
>
  <section class="arcade-intro">
    <p class="insert">Direction 03 // Insert curiosity</p>
    <h1>Ready, player?</h1>
    <p>Discover the campaigns climbing this week's board.</p>
  </section>

  {featured && (
    <section class="spotlight" data-testid="preview-game-card">
      <div class="spotlight-art" aria-hidden="true">
        <span>{featured.title.slice(0, 2).toUpperCase()}</span>
      </div>
      <div>
        <p class="label">Player one's pick</p>
        <h2>{featured.title}</h2>
        <p>{featured.description}</p>
        <div class="featured-stats">
          <p><strong>{featured.previewRating.toFixed(1)}</strong> rating</p>
          <p><strong>{formatCurrency(featured.funding.pledged)}</strong> pledged</p>
          <p><strong>{featured.funding.backers.toLocaleString()}</strong> backers</p>
        </div>
        <p class="illustrative">Scores and funding totals are <strong>illustrative</strong>.</p>
      </div>
    </section>
  )}

  <section class="leaderboard" aria-labelledby="leaderboard-title" data-testid="preview-catalog">
    <div class="board-heading">
      <p>Live catalog // Ranked by backer rating</p>
      <h2 id="leaderboard-title">High scores</h2>
    </div>
    <ol>
      {rankedGames.map((game, index) => (
        <li data-testid="preview-game-card">
          <span class="rank">{String(index + 2).padStart(2, '0')}</span>
          <div>
            <h3>{game.title}</h3>
            <p>{game.category?.name ?? 'Independent'} · {game.publisher?.name ?? 'Tailspin workshop'}</p>
          </div>
          <span class="rating" aria-label={`${game.previewRating.toFixed(1)} rating`}>
            {game.previewRating.toFixed(1)}
          </span>
        </li>
      ))}
    </ol>
  </section>
</PreviewLayout>

<style>
  :global(html[data-preview-theme='arcade']) {
    background: #090315;
    color: #fff5fb;
  }

  :global(html[data-preview-theme='arcade'] .preview-header) {
    background: #090315;
    color: #35f2d0;
    border-color: #5a246f;
  }

  .arcade-intro {
    padding: clamp(3rem, 8vw, 7rem) clamp(1rem, 6vw, 5rem) 2rem;
    text-align: center;
    background: radial-gradient(circle at 50% 100%, rgb(251 46 134 / 26%), transparent 55%);
  }

  .insert,
  .label,
  .board-heading p {
    color: #35f2d0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.5rem 0;
    color: #fff5fb;
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    font-size: clamp(4rem, 14vw, 11rem);
    font-weight: 400;
    letter-spacing: 0.015em;
    line-height: 0.9;
    text-shadow: 0.06em 0.06em 0 #7b185d;
    text-transform: uppercase;
  }

  .arcade-intro > p:last-child {
    font-size: 1.15rem;
  }

  .spotlight {
    display: grid;
    grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    max-width: 80rem;
    margin: 2rem auto 6rem;
    padding: clamp(1rem, 4vw, 3rem);
  }

  .spotlight-art {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background:
      linear-gradient(135deg, transparent 40%, rgb(53 242 208 / 28%) 40% 45%, transparent 45%),
      linear-gradient(45deg, #fb2e86, #511d7e);
    border: 0.3rem solid #35f2d0;
    box-shadow: 1rem 1rem 0 #fb2e86;
    transform: rotate(-2deg);
  }

  .spotlight-art span {
    font-family: Impact, sans-serif;
    font-size: clamp(5rem, 15vw, 10rem);
    text-shadow: 0.05em 0.05em 0 #090315;
  }

  .spotlight h2 {
    margin: 0.5rem 0;
    font-family: Impact, Haettenschweiler, sans-serif;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 400;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .spotlight > div:last-child > p:not(.label, .illustrative) {
    max-width: 42rem;
    color: #d6c7df;
    line-height: 1.65;
  }

  .featured-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .featured-stats p {
    margin: 0;
    color: #d6c7df;
  }

  .featured-stats strong {
    display: block;
    color: #35f2d0;
    font-size: 1.35rem;
  }

  .illustrative {
    margin-top: 2rem;
    color: #ffd6e8;
    font-size: 0.8rem;
  }

  .leaderboard {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 clamp(1rem, 5vw, 4rem) 6rem;
  }

  .board-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 3px solid #fb2e86;
  }

  .board-heading h2 {
    margin: 0;
    font-family: Impact, sans-serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 400;
    text-transform: uppercase;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 1.25rem 0;
    border-bottom: 1px solid #5a246f;
  }

  .rank,
  .rating {
    color: #35f2d0;
    font-family: ui-monospace, monospace;
    font-size: 1.25rem;
    font-weight: 800;
  }

  li h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  li p {
    margin: 0.3rem 0 0;
    color: #bfaecb;
    font-size: 0.85rem;
  }

  .rating {
    padding: 0.45rem 0.65rem;
    color: #090315;
    background: #35f2d0;
  }

  @media (max-width: 48rem) {
    .spotlight {
      grid-template-columns: 1fr;
    }

    .board-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    li {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    }
  }
</style>
