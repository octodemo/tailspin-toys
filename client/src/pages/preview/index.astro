---
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import { getPreviewGames } from '../../lib/preview';

export const prerender = false;

const games = await getPreviewGames();
const directions = [
  {
    slug: 'tabletop',
    number: '01',
    title: 'The Tabletop',
    summary: 'Campaigns become tactile objects on a felt-covered table, with cardboard edges and brass funding pips.',
    palette: ['#183d32', '#e8dcc4', '#bd8a3b'],
    type: 'Rockwell / Georgia / system serif',
  },
  {
    slug: 'pipeline',
    number: '02',
    title: 'The Pipeline',
    summary: 'A bright technical rail tracks campaigns from concept through prototype and into production.',
    palette: ['#f3f6f8', '#102a43', '#0d9488'],
    type: 'IBM Plex Sans / ui-monospace',
  },
  {
    slug: 'arcade',
    number: '03',
    title: 'The Arcade',
    summary: 'One campaign takes the spotlight while the catalog competes in a high-score leaderboard.',
    palette: ['#090315', '#fb2e86', '#35f2d0'],
    type: 'Impact / Arial Black / system sans',
  },
  {
    slug: 'type',
    number: '04',
    title: 'Type Specimens',
    summary: 'Compare expressive display faces against real titles and descriptions from the catalog.',
    palette: ['#f2eadf', '#29221f', '#c24b32'],
    type: 'Four display systems compared',
  },
];
---

<PreviewLayout
  title="Choose a visual direction"
  description="Four alternative visual directions for the Tailspin Toys crowdfunding catalog."
  theme="chooser"
>
  <section class="chooser-hero">
    <p class="eyebrow">Temporary design study / {games.length} live campaigns</p>
    <h1>What should crowdfunding for developer games feel like?</h1>
    <p class="lede">
      Four working directions, each using the real Tailspin Toys catalog. Choose a route to compare the same content
      through a different visual system.
    </p>
    <p class="notice">
      Funding totals shown in these previews are <strong>illustrative</strong> and deterministically derived from each game ID.
    </p>
  </section>

  <section class="directions" aria-label="Visual directions" data-testid="preview-chooser">
    {directions.map((direction) => (
      <article>
        <div class="direction-number" aria-hidden="true">{direction.number}</div>
        <div>
          <h2>{direction.title}</h2>
          <p>{direction.summary}</p>
          <div class="palette" aria-label={`${direction.title} color palette`}>
            {direction.palette.map((color) => <span style={`--swatch:${color}`}><span class="sr-only">{color}</span></span>)}
          </div>
          <p class="type-note">{direction.type}</p>
          <a href={`/preview/${direction.slug}`} data-testid={`preview-direction-${direction.slug}`}>
            Open direction <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    ))}
  </section>
</PreviewLayout>

<style>
  :global(html[data-preview-theme='chooser']) {
    background: #efece5;
    color: #20201e;
  }

  :global(html[data-preview-theme='chooser'] .preview-header) {
    background: #efece5;
  }

  .chooser-hero {
    max-width: 76rem;
    padding: clamp(3rem, 9vw, 8rem) clamp(1rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem);
  }

  .eyebrow,
  .type-note {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin: 1.25rem 0;
    font-family: Georgia, serif;
    font-size: clamp(2.7rem, 8vw, 6.8rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .lede {
    max-width: 48rem;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.6;
  }

  .notice {
    max-width: 48rem;
    margin-top: 1.5rem;
    padding: 0.9rem 1rem;
    border-left: 4px solid #20201e;
  }

  .directions {
    border-top: 1px solid #20201e;
  }

  article {
    display: grid;
    grid-template-columns: minmax(3rem, 0.25fr) minmax(0, 1fr);
    gap: 1rem;
    padding: clamp(2rem, 5vw, 4rem) clamp(1rem, 6vw, 5rem);
    border-bottom: 1px solid #20201e;
    transition: background 180ms ease;
  }

  article:hover {
    background: #e2ddd2;
  }

  .direction-number {
    font-family: ui-monospace, monospace;
  }

  h2 {
    margin: 0;
    font-family: Georgia, serif;
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 500;
  }

  article p {
    max-width: 46rem;
    line-height: 1.6;
  }

  article a {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 800;
    text-underline-offset: 0.3rem;
  }

  .palette {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .palette > span {
    width: 2.25rem;
    height: 2.25rem;
    background: var(--swatch);
    border: 1px solid #20201e;
    border-radius: 50%;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
</style>
